A2B; }\n        .dl-global-error button:active { background: #6CF1C9; color: #0F2B46; }\n        /* marketing-ui Button secondary (quartz-gray / jade-green) */\n        .dl-global-error .dl-global-error-actions a {\n          background: #EDEDED;\n          color: #0F2B46;\n        }\n        .dl-global-error .dl-global-error-actions a:hover {\n          background: #D5D6D6;\n        }\n        .dl-global-error .dl-global-error-actions a:active {\n          background: #6CF1C9;\n        }\n        .dl-global-error header a {\n          display: inline-flex;\n          align-items: center;\n          gap: 10px; /* header logo span gap-2.5 */\n        }\n        /* footer links: text-sm text-redesign-slate-gray-400, matching the\n           home footer (homeFooter.tsx). Same container as main below, so the\n           links line up with the headline. */\n        .dl-global-error footer {\n          display: flex;\n          flex-wrap: wrap;\n          gap: 16px 24px;\n          padding: 24px 32px;\n          font-size: 14px;\n          line-height: 1;\n        }\n        .dl-global-error footer a {\n          color: #3B435C;\n          text-decoration: none;\n        }\n        .dl-global-error footer a:hover { color: #0F2B46; }\n        .dl-global-error picture { padding: 24px 32px; }\n        .dl-global-error img { max-width: min(448px, 100%); height: auto; }\n        @media (min-width: 768px) {\n          .dl-global-error main {\n            flex-direction: row;\n            justify-content: space-between;\n            gap: 64px;\n            width: 100%;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 32px 70px;\n            box-sizing: border-box;\n            text-align: start;\n          }\n          .dl-global-error section {\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 24px;\n          }\n          .dl-global-error h1 { font-size: 56px; }\n          .dl-global-error .dl-global-error-actions {\n            justify-content: flex-start;\n          }\n          /* footer shares main's container so the legal links align with the\n             headline; the header keeps its own full-width padding */\n          .dl-global-error footer {\n            width: 100%;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding-inline: 70px;\n            box-sizing: border-box;\n          }\n        }\n      "}),d[0]=e):e=d[0],d[1]===Symbol.for("react.memo_cache_sentinel")?(r=(0,n.jsx)("header",{children:(0,n.jsx)("a",{href:"/","aria-label":"DeepL homepage",children:(0,n.jsx)(i,{})})}),l=(0,n.jsx)("h1",{children:"Something went wrong"}),a=(0,n.jsx)("p",{children:"Sorry about that. Refreshing the page usually fixes it."}),d[1]=r,d[2]=l,d[3]=a):(r=d[1],l=d[2],a=d[3]),d[4]===Symbol.for("react.memo_cache_sentinel")?(c=(0,n.jsxs)("div",{className:`dl-global-error ${o.robotoLatin.className}`,"data-testid":"global-error-page",children:[e,r,(0,n.jsxs)("main",{children:[(0,n.jsxs)("section",{children:[l,a,(0,n.jsxs)("div",{className:"dl-global-error-actions",children:[(0,n.jsx)("button",{type:"button",onClick:s,children:"Refresh page"}),(0,n.jsx)("a",{href:"/",children:"Go to homepage"})]})]}),(0,n.jsx)("picture",{children:(0,n.jsx)("img",{src:"/img/illustrations/404_page.svg?v=3",alt:"",width:"448",height:"448",loading:"eager"})})]}),(0,n.jsxs)("footer",{children:[(0,n.jsx)("a",{href:"/privacy",children:"Privacy policy"}),(0,n.jsx)("a",{href:"/publisher",children:"Publisher"}),(0,n.jsx)("a",{href:"/pro-license",children:"Terms & Conditions"})]})]}),d[4]=c):c=d[4],c}function s(){return window.location.reload()}let c=/ChunkLoadError|Loading chunk .+ failed|dynamically imported module|Importing a module script failed/i;function d(e){return c.test(`${e.name}: ${e.message}`)}e.s(["default",0,function(e){let o,i,s,c=(0,t.c)(4),{error:h}=e;return c[0]!==h?(o=()=>{r.Sentry.withScope(e=>{e.setTag("staleChunk",String(d(h