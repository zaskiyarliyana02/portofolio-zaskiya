expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/pt-PT/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"O DeepL está agora disponível no Microsoft Copilot, no ChatGPT e no Claude através do MCP","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ligue o DeepL a Microsoft Copilot, ao ChatGPT, ao Claude e a outras ferramentas compatíveis para traduzir textos e documentos diretamente com o DeepL","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/pt-PT/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"O DeepL Voice preserva agora a sua voz em tempo real em todos os idiomas","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"A tradução de voz em tempo real preserva agora o tom e a voz de cada interlocutor em todos os idiomas, com uma aplicação para desktop unificada para o Zoom, o Teams e o Google Meet.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/pt-PT/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"Camada de áudio em tempo real para tradução de voz","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"API DeepL Voice: protocolos de áudio personalizados e modelos de tradução de ponta a ponta para áudio voz a voz com latência ultrabaixa.","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/pt-PT/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"Desenvolvimento da Avaliação da Qualidade de Tradução no DeepL","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Modelos de avaliação independentes detetam erros de tradução automática, simplificam fluxos de trabalho e aumentam a confiança na localização com IA.","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/pt-PT/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"De tradução de texto a plataforma de voz em tempo real","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Modelos diretos de áudio em voz reduzem latência e captam nuances vocais, oferecendo tradução em tempo real superior às ferramentas convencionais.","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/pt-PT/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}],"ru":[{"id":"5OjIfi6FHdHGnmwy8XJEuC","createdAt":"2026-08-03T09:37:27.352Z","updatedAt":"2026-08-03T09:37:27.352Z","title":"DeepL для ИИ-агентов","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Теперь вы можете использовать DeepL прямо в Claude, ChatGPT, Microsoft Copilot и любом агенте, совместимом с MCP. Теперь ваши агенты могут выполнять перевод в соответствии с корпоративными стандартами вашей компании: с использованием вашей терминологии, вашей формы обращения и ваших стандартов качества.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Администраторы могут включать или отключать доступ в настройках организации.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-15","link":"https://www.deepl.com/ru/ai-agents","linkLabel":"Ознакомьтесь с DeepL для ИИ-агентов","relatedContent":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"pplyeawnfzc7"}},"id":"4dEWf3690LvxYVkZEHToqt","type":"Entry","createdAt":"2026-07-15T10:55:54.203Z","updatedAt":"2026-09-24T12:53:59.842Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":132,"revision":21,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"landingPage"}},"locale":"ru"},"fields":{"title":"DeepL для ИИ-агентов: перевод там, где ваш ИИ","description":"Подключите DeepL к Claude, ChatGPT, Microsoft Copilot и любому клиенту MCP — переводите, создавайте тексты и сохраняйте терминологию компании внутри ИИ-агентов.","urlPath":"ai-agents","urlPathVerification":"verified","publicationLocales":["ar","cs","de","en","es","fr","id","it","ja","ko","nl","pl","pt-BR","pt-PT","ru","sv","tr","uk","zh"],"dapPageId":1991,"pageOwner":"API","seoIndexation":true,"expandAllLinkCards":true,"header":[],"pageSections":[]}}],"sourceType":"notification"},{"id":"2TuRycS8zrSVTdPJh1MJX7","createdAt":"2026-07-07T12:00:16.677Z","updatedAt":"2026-07-08T15:21:02.536Z","title":"Translation Flow в DeepL: Новые рабочие процессы на базе ИИ для ключевых сценариев использования и интеграций","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"В Translation Flow добавлены новые обновления и интеграции для поддержки ключевых сценариев использования, включая Adobe Experience Manager и InDesign для маркетинга; XLIFF для обучения и развития; а также SharePoint и Google Drive для отдела кадров и других подразделений.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Оптимизируйте многоязычные проекты с помощью комплексных рабочих процессов, в основе которых лежит ИИ, и сделайте Translation Flow доступным для ещё большего числа ваших функциональных команд.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-07","link":"https://www.deepl.com/ru/translation-flow","linkLabel":"Ознакомьтесь с Translation Flow","sourceType":"notification"},{"id":"5HVK3MiQelBTMqYffAIY9t","createdAt":"2026-06-04T22:34:12.599Z","updatedAt":"2026-06-04T22:34:12.599Z","title":"The ROI of AI-native translation","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nucleus Research found enterprise teams can cut localization spend by 80-90%, and compress timelines from weeks to hours — without the quality tradeoffs of generic AI.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-06-05","link":"https://www.deepl.com/en/reports/nucleus-roi-study","linkLabel":"Read the findings","sourceType":"notification"},{"id":"blog-66YKFU5PLiw3kthXLnhjVc","createdAt":"2026-09-22T03:23:18.386Z","updatedAt":"2026-09-22T03:23:18.386Z","title":"What MCP changes about enterprise software","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Discover how the Model Context Protocol (MCP) shifts enterprise software from generalist reasoning to specialist capability. Explore expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/ru/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"DeepL теперь доступен в Microsoft Copilot, ChatGPT и Claude через MCP","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Подключите DeepL к Microsoft Copilot, ChatGPT, Claude и другим совместимым инструментам, чтобы переводить тексты и документы непосредственно с помощью DeepL","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/ru/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"DeepL Voice теперь сохраняет интонацию и тембр Вашего голоса в режиме реального времени при переводе между языками","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Функция голосового перевода в режиме реального времени теперь сохраняет форму обращения и тембр голоса каждого говорящего при переводе между языками благодаря унифицированному настольному приложению для Zoom, Teams и Google Meet.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/ru/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"Аудиослой реального времени для голосового перевода","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"DeepL Voice API: настраиваемые аудиопротоколы и сквозные модели перевода для аудиоперевода «речь-речь» с минимальной задержкой.","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/ru/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"Как мы разрабатываем систему оценки качества перевода для DeepL","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Узнайте, как независимые модели оценки выявляют ошибки МП, оптимизируют работу редакторов и повышают доверие к локализации с ИИ.","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/ru/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"От перевода текста до голосовой платформы реального времени","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Модели прямого преобразования аудио в речь минимизируют задержку и передают нюансы голоса для превосходного перевода в реальном времени.","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/ru/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}],"sv":[{"id":"5OjIfi6FHdHGnmwy8XJEuC","createdAt":"2026-08-03T09:37:27.352Z","updatedAt":"2026-08-03T09:37:27.352Z","title":"DeepL för AI-agenter","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nu kan du använda DeepL direkt i Claude, ChatGPT, Microsoft Copilot och alla MCP-kompatibla agenter. Nu kan dina agenter översätta på samma sätt som ditt företag gör: med dina termer, ditt tilltal och dina kvalitetsstandarder.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Administratörer kan aktivera eller inaktivera åtkomsten i organisationsinställningarna.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-15","link":"https://www.deepl.com/sv/ai-agents","linkLabel":"Upptäck DeepL för AI-agenter","relatedContent":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"pplyeawnfzc7"}},"id":"4dEWf3690LvxYVkZEHToqt","type":"Entry","createdAt":"2026-07-15T10:55:54.203Z","updatedAt":"2026-09-24T12:53:59.842Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":132,"revision":21,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"landingPage"}},"locale":"sv"},"fields":{"title":"DeepL för AI-agenter: översätt där din AI finns","description":"Anslut DeepL till Claude, ChatGPT, Microsoft Copilot och valfri MCP-klient. Få översättning, skrivande och ditt företags terminologi direkt i dina AI-agenter.","urlPath":"ai-agents","urlPathVerification":"verified","publicationLocales":["ar","cs","de","en","es","fr","id","it","ja","ko","nl","pl","pt-BR","pt-PT","ru","sv","tr","uk","zh"],"dapPageId":1991,"pageOwner":"API","seoIndexation":true,"expandAllLinkCards":true,"header":[],"pageSections":[]}}],"sourceType":"notification"},{"id":"2TuRycS8zrSVTdPJh1MJX7","createdAt":"2026-07-07T12:00:16.677Z","updatedAt":"2026-07-08T15:21:02.536Z","title":"DeepL:s Translation Flow: Nya AI-drivna arbetsflöden för viktiga användningsfall och integrationer","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Translation Flow har fått nya uppdateringar och integrationer för att stödja viktiga användningsfall, bland annat Adobe Experience Manager och InDesign för marknadsföring, XLIFF för utbildning och utveckling samt SharePoint och Google Drive för HR och andra avdelningar.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Effektivisera flerspråkiga projekt med AI-baserade, heltäckande arbetsflöden och gör Translation Flow tillgängligt för ännu fler av dina funktionsteam.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-07","link":"https://www.deepl.com/sv/translation-flow","linkLabel":"Utforska Translation Flow","sourceType":"notification"},{"id":"5HVK3MiQelBTMqYffAIY9t","createdAt":"2026-06-04T22:34:12.599Z","updatedAt":"2026-06-04T22:34:12.599Z","title":"The ROI of AI-native translation","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nucleus Research found enterprise teams can cut localization spend by 80-90%, and compress timelines from weeks to hours — without the quality tradeoffs of generic AI.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-06-05","link":"https://www.deepl.com/en/reports/nucleus-roi-study","linkLabel":"Read the findings","sourceType":"notification"},{"id":"blog-66YKFU5PLiw3kthXLnhjVc","createdAt":"2026-09-22T03:23:18.386Z","updatedAt":"2026-09-22T03:23:18.386Z","title":"What MCP changes about enterprise software","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Discover how the Model Context Protocol (MCP) shifts enterprise software from generalist reasoning to specialist capability. Explore expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/sv/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"DeepL finns nu tillgängligt i Microsoft Copilot, ChatGPT och Claude via MCP","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Anslut DeepL till Microsoft Copilot, ChatGPT, Claude och andra kompatibla verktyg för att översätta text och dokument direkt med DeepL","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/sv/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"DeepL Voice bevarar nu din röst i realtid oavsett språk","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Röstöversättning i realtid bevarar nu varje talares tonfall och röst över olika språk, med en gemensam skrivbordsapp för Zoom, Teams och Google Meet.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/sv/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"Ljudlager i realtid som revolutionerar röstöversättning","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"DeepL Voice API kombinerar anpassade ljudprotokoll och end-to-end-översättning för tal-till-tal med extremt låg latens.","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/sv/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"DeepLs system för översättningskvalitetsbedömning","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Lär dig hur oberoende utvärderingsmodeller upptäcker fel i maskinöversättningar, effektiviserar granskning och ökar förtroendet för AI-översättning.","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/sv/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"Från högkvalitativ textöversättning till röstplattform i realtid","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Upptäck hur direkt ljud-till-tal-modeller minimerar fördröjning och fångar röstnyanser för realtidsöversättning som överträffar standardverktyg.","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/sv/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}],"tr":[{"id":"5OjIfi6FHdHGnmwy8XJEuC","createdAt":"2026-08-03T09:37:27.352Z","updatedAt":"2026-08-03T09:37:27.352Z","title":"AI ajanları için DeepL","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Artık DeepL’i doğrudan Claude, ChatGPT, Microsoft Copilot ve MCP uyumlu tüm ajanlarda kullanabilirsiniz. Artık ajanslarınız, şirketinizin kullandığı terimleri, tona ve kalite standartlarına uygun olarak çeviri yapabilir.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Yöneticiler, kuruluş ayarlarından bu özelliğe erişimi etkinleştirebilir veya devre dışı bırakabilir.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-15","link":"https://www.deepl.com/tr/ai-agents","linkLabel":"Yapay zeka ajansları için DeepL\'i keşfedin","relatedContent":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"pplyeawnfzc7"}},"id":"4dEWf3690LvxYVkZEHToqt","type":"Entry","createdAt":"2026-07-15T10:55:54.203Z","updatedAt":"2026-09-24T12:53:59.842Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":132,"revision":21,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"landingPage"}},"locale":"tr"},"fields":{"title":"AI ajanları için DeepL: AI\'nız neredeyse orada çeviri","description":"DeepL\'i Claude, ChatGPT, Copilot ve MCP istemcilerine bağlayın — AI ajanlarınızda çeviri, yazma ve şirket terminolojisi kullanın.","urlPath":"ai-agents","urlPathVerification":"verified","publicationLocales":["ar","cs","de","en","es","fr","id","it","ja","ko","nl","pl","pt-BR","pt-PT","ru","sv","tr","uk","zh"],"dapPageId":1991,"pageOwner":"API","seoIndexation":true,"expandAllLinkCards":true,"header":[],"pageSections":[]}}],"sourceType":"notification"},{"id":"2TuRycS8zrSVTdPJh1MJX7","createdAt":"2026-07-07T12:00:16.677Z","updatedAt":"2026-07-08T15:21:02.536Z","title":"DeepL Translation Flow: Önemli kullanım senaryoları ve entegrasyonlar için yeni yapay zeka destekli iş akışları","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Translation Flow, Adobe Experience Manager ve InDesign for Marketing; L&D için XLIFF; İK ve diğerleri için SharePoint ve Google Drive dahil olmak üzere önemli kullanım senaryolarını desteklemek üzere yeni güncellemeler ve entegrasyonlar ekledi.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Yapay zeka odaklı, uçtan uca iş akışlarıyla çok dilli projeleri kolaylaştırın ve Translation Flow\'u daha fazla iş biriminizin erişimine açın.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-07","link":"https://www.deepl.com/tr/translation-flow","linkLabel":"Translation Flow\'u keşfedin","sourceType":"notification"},{"id":"5HVK3MiQelBTMqYffAIY9t","createdAt":"2026-06-04T22:34:12.599Z","updatedAt":"2026-06-04T22:34:12.599Z","title":"The ROI of AI-native translation","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nucleus Research found enterprise teams can cut localization spend by 80-90%, and compress timelines from weeks to hours — without the quality tradeoffs of generic AI.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-06-05","link":"https://www.deepl.com/en/reports/nucleus-roi-study","linkLabel":"Read the findings","sourceType":"notification"},{"id":"blog-66YKFU5PLiw3kthXLnhjVc","createdAt":"2026-09-22T03:23:18.386Z","updatedAt":"2026-09-22T03:23:18.386Z","title":"What MCP changes about enterprise software","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Discover how the Model Context Protocol (MCP) shifts enterprise software from generalist reasoning to specialist capability. Explore expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/tr/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"DeepL artık MCP aracılığıyla Microsoft Copilot, ChatGPT ve Claude’da kullanılabilir","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"DeepL\'i Microsoft Copilot, ChatGPT, Claude ve diğer uyumlu araçlara bağlayarak metinleri ve belgeleri doğrudan DeepL ile çevirin","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/tr/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"DeepL Voice artık sesinizi diller arası gerçek zamanlı olarak koruyor","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Gerçek zamanlı ses çevirisi, Zoom, Teams ve Google Meet için tek bir masaüstü uygulaması sayesinde her konuşmacının ses tonunu ve sesini diller arasında koruyor.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/tr/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"Ses çevirisini dönüştürmeye hazır gerçek zamanlı ses katmanı","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"DeepL Voice API\'sı özel ses protokolleri ve uçtan uca çeviri modelleriyle ultra düşük gecikmeli, konuşmadan konuşmaya ses çevirisi sunar.","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/tr/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"DeepL için Çeviri Kalite Değerlendirmesini Nasıl Geliştiriyoruz","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Bağımsız değerlendirme modelleri makine çevirisi hatalarını tespit eder, inceleme süreçlerini kolaylaştırır ve yapay zeka yerelleştirmesine güveni artırır.","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/tr/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"Yüksek kaliteli metin çevirisinden gerçek zamanlı ses platformuna","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Doğrudan ses-konuşma modellerinin gecikmeyi azaltıp ses tonlarını nasıl yakaladığını keşfedin; gerçek zamanlı çeviri deneyimi yaşayın.","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/tr/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}],"uk":[{"id":"5OjIfi6FHdHGnmwy8XJEuC","createdAt":"2026-08-03T09:37:27.352Z","updatedAt":"2026-08-03T09:37:27.352Z","title":"DeepL для ШІ-агентів","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Тепер ви можете використовувати DeepL безпосередньо в Claude, ChatGPT, Microsoft Copilot та будь-якому агенті, сумісному з MCP. Тепер ваші агенти можуть перекладати так, як це робить ваша компанія: використовуючи ваші терміни, ваш тон та ваші стандарти якості.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Адміністратори можуть увімкнути або вимкнути доступ у налаштуваннях організації.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-15","link":"https://www.deepl.com/uk/ai-agents","linkLabel":"Ознайомтеся з DeepL для ШІ-агентів","relatedContent":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"pplyeawnfzc7"}},"id":"4dEWf3690LvxYVkZEHToqt","type":"Entry","createdAt":"2026-07-15T10:55:54.203Z","updatedAt":"2026-09-24T12:53:59.842Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":132,"revision":21,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"landingPage"}},"locale":"uk"},"fields":{"title":"DeepL для ШІ-агентів: перекладайте там, де працює ваш ШІ","description":"Під’єднуйте DeepL до Claude, ChatGPT, Microsoft Copilot та будь-якого MCP-клієнта — переклад, написання текстів і термінологія компанії у ваших ШІ-агентах.","urlPath":"ai-agents","urlPathVerification":"verified","publicationLocales":["ar","cs","de","en","es","fr","id","it","ja","ko","nl","pl","pt-BR","pt-PT","ru","sv","tr","uk","zh"],"dapPageId":1991,"pageOwner":"API","seoIndexation":true,"expandAllLinkCards":true,"header":[],"pageSections":[]}}],"sourceType":"notification"},{"id":"2TuRycS8zrSVTdPJh1MJX7","createdAt":"2026-07-07T12:00:16.677Z","updatedAt":"2026-07-08T15:21:02.536Z","title":"Translation Flow в DeepL: Нові робочі процеси на основі ШІ для основних сценаріїв використання та інтеграцій","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Translation Flow отримав нові оновлення та інтеграції для підтримки основних сценаріїв використання, зокрема Adobe Experience Manager та InDesign для маркетингу; XLIFF для навчання та розвитку; а також SharePoint і Google Drive для управління персоналом та інших сфер.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Оптимізуйте багатомовні проєкти за допомогою комплексних робочих процесів, що базуються на ШІ, та зробіть Translation Flow доступним для ще більшої кількості ваших функціональних команд.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-07","link":"https://www.deepl.com/uk/translation-flow","linkLabel":"Дізнайтеся більше про Translation Flow","sourceType":"notification"},{"id":"5HVK3MiQelBTMqYffAIY9t","createdAt":"2026-06-04T22:34:12.599Z","updatedAt":"2026-06-04T22:34:12.599Z","title":"The ROI of AI-native translation","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nucleus Research found enterprise teams can cut localization spend by 80-90%, and compress timelines from weeks to hours — without the quality tradeoffs of generic AI.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-06-05","link":"https://www.deepl.com/en/reports/nucleus-roi-study","linkLabel":"Read the findings","sourceType":"notification"},{"id":"blog-66YKFU5PLiw3kthXLnhjVc","createdAt":"2026-09-22T03:23:18.386Z","updatedAt":"2026-09-22T03:23:18.386Z","title":"What MCP changes about enterprise software","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Discover how the Model Context Protocol (MCP) shifts enterprise software from generalist reasoning to specialist capability. Explore expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/uk/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"Тепер DeepL доступний у Microsoft Copilot, ChatGPT та Claude через MCP","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Підключіть DeepL до Microsoft Copilot, ChatGPT, Claude та інших сумісних інструментів, щоб перекласти текст і документи безпосередньо за допомогою DeepL","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/uk/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"DeepL Voice тепер зберігає особливості вашого голосу в режимі реального часу під час перекладу між мовами","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Голосовий переклад в режимі реального часу тепер зберігає тон та голос кожного мовця при перекладі між мовами завдяки уніфікованій настільній програмі для Zoom, Teams та Google Meet.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/uk/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"Аудіошар з голосовим перекладом у реальному часі","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"DeepL Voice API поєднує аудіопротоколи та наскрізні моделі перекладу для аудіоперекладу «від мови до мови» з надзвичайно низькою затримкою.","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/uk/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"Як ми розробляємо систему оцінювання якості перекладу для DeepL","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Дізнайтеся, як незалежні моделі оцінки виявляють помилки машинного перекладу, оптимізують роботу редакторів та підвищують довіру до ШІ-локалізації.","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/uk/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"Від якісного перекладу до голосової платформи реального часу","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Дізнайтеся, як аудіо-мова моделі мінімізують затримку та передають голосові нюанси для перекладу в реальному часі, що перевершує стандартні інструменти.","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/uk/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}],"zh":[{"id":"5OjIfi6FHdHGnmwy8XJEuC","createdAt":"2026-08-03T09:37:27.352Z","updatedAt":"2026-08-03T09:37:27.352Z","title":"DeepL 人工智能智能体","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"现在，您可以在Claude、ChatGPT、Microsoft Copilot以及任何兼容MCP的智能助手中直接使用DeepL。现在，您的聊天机器人可以按照贵公司的风格进行翻译：采用贵公司的术语、语气和质量标准。","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"管理员可在组织设置中启用或禁用此功能。","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-15","link":"https://www.deepl.com/zh/ai-agents","linkLabel":"探索适用于人工智能聊天机器人的 DeepL","relatedContent":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"pplyeawnfzc7"}},"id":"4dEWf3690LvxYVkZEHToqt","type":"Entry","createdAt":"2026-07-15T10:55:54.203Z","updatedAt":"2026-09-24T12:53:59.842Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":132,"revision":21,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"landingPage"}},"locale":"zh"},"fields":{"title":"DeepL 人工智能智能体：让人工智能在工作场景中随时实现精准翻译","description":"将 DeepL 连接至 Claude、ChatGPT、Microsoft Copilot 和任何支持 MCP 的客户端，让翻译、写作和企业术语能力融入人工智能智能体。","urlPath":"ai-agents","urlPathVerification":"verified","publicationLocales":["ar","cs","de","en","es","fr","id","it","ja","ko","nl","pl","pt-BR","pt-PT","ru","sv","tr","uk","zh"],"dapPageId":1991,"pageOwner":"API","seoIndexation":true,"expandAllLinkCards":true,"header":[],"pageSections":[]}}],"sourceType":"notification"},{"id":"2TuRycS8zrSVTdPJh1MJX7","createdAt":"2026-07-07T12:00:16.677Z","updatedAt":"2026-07-08T15:21:02.536Z","title":"DeepL Translation Flow：针对关键应用场景和集成的新型人工智能驱动工作流","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Translation Flow 已推出新更新和集成功能，以支持关键应用场景，包括面向市场营销的 Adobe Experience Manager 和 InDesign；面向学习与发展（L&D）的 XLIFF；以及面向人力资源（HR）及其他领域的 SharePoint 和 Google Drive。","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"借助以人工智能为核心的端到端工作流，优化多语言项目，让更多职能团队都能便捷地使用 Translation Flow。","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-07-07","link":"https://www.deepl.com/zh/translation-flow","linkLabel":"探索 Translation Flow","sourceType":"notification"},{"id":"5HVK3MiQelBTMqYffAIY9t","createdAt":"2026-06-04T22:34:12.599Z","updatedAt":"2026-06-04T22:34:12.599Z","title":"The ROI of AI-native translation","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Nucleus Research found enterprise teams can cut localization spend by 80-90%, and compress timelines from weeks to hours — without the quality tradeoffs of generic AI.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"publicationDate":"2026-06-05","link":"https://www.deepl.com/en/reports/nucleus-roi-study","linkLabel":"Read the findings","sourceType":"notification"},{"id":"blog-66YKFU5PLiw3kthXLnhjVc","createdAt":"2026-09-22T03:23:18.386Z","updatedAt":"2026-09-22T03:23:18.386Z","title":"What MCP changes about enterprise software","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Discover how the Model Context Protocol (MCP) shifts enterprise software from generalist reasoning to specialist capability. Explore expert insights on maintaining compliance, scaling AI agents, and integrating domain-specific AI into your workflow.","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T00:00-05:00","link":"/zh/blog/what-mcp-changes-about-enterprise-software","sourceType":"blog"},{"id":"blog-5g1BOvx4UriGh81tLNNg43","createdAt":"2026-09-22T03:17:26.011Z","updatedAt":"2026-09-22T03:17:26.011Z","title":"DeepL 现已通过 MCP 集成到 Microsoft Copilot、ChatGPT 和 Claude 中","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"将 DeepL 连接到 Microsoft Copilot、ChatGPT、Claude 及其他兼容工具，即可直接使用 DeepL 翻译文本和文档","marks":[],"data":{}}]}]},"publicationDate":"2026-09-22T04:00+02:00","link":"/zh/blog/deepl-available-in-microsoft-copilot-chatgpt-claude-mcp","sourceType":"blog"},{"id":"blog-1feRaDLVNBsP7Bw5dh8cu4","createdAt":"2026-09-15T05:37:47.445Z","updatedAt":"2026-09-15T05:37:47.445Z","title":"DeepL Voice 现可跨语言实时保留您的原声","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"实时语音翻译现可在跨语言交流中保留每位说话者的语气和声音特色，并提供适用于 Zoom、Teams 和 Google Meet 的统一桌面应用程序。","marks":[],"data":{}}]}]},"publicationDate":"2026-09-15T08:00-04:00","link":"/zh/blog/deepl-voice-preserves-your-voice-across-languages","sourceType":"blog"},{"id":"ailabs-Tf75UAj5SWnfpt1e1rW0P","createdAt":"2026-08-20T04:23:43.350Z","updatedAt":"2026-08-20T04:23:43.350Z","title":"实时音频层，即将革新语音翻译","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"了解 DeepL Voice API 如何结合自定义音频协议和端到端翻译模型，实现超低延迟的语音到语音翻译。","marks":[],"data":{}}]}]},"publicationDate":"2026-08-20T04:23:43.350Z","link":"/zh/ai-labs/real-time-audio-layer-transforming-voice-translation","sourceType":"aiLabs"},{"id":"ailabs-6qUCT8Vrhyv2Mo6IOkG7vE","createdAt":"2026-07-20T23:56:07.154Z","updatedAt":"2026-07-20T23:56:07.154Z","title":"我们如何构建 DeepL 的翻译质量评估系统","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"了解独立评估模型如何检测机器翻译错误、优化审阅人工作流程，并提升对人工智能本地化的信任度。","marks":[],"data":{}}]}]},"publicationDate":"2026-07-20T23:56:07.154Z","link":"/zh/ai-labs/building-translation-quality-evaluation","sourceType":"aiLabs"},{"id":"ailabs-7n9gJDN02FQEzeEXsQXmqA","createdAt":"2026-06-21T21:56:12.896Z","updatedAt":"2026-06-21T21:56:12.896Z","title":"从高质量文本翻译到实时语音平台","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"了解直接音频转语音模型如何最大限度地降低延迟并捕捉语音的细微差别，提供超越标准工具的产品实时翻译服务。","marks":[],"data":{}}]}]},"publicationDate":"2026-06-21T21:56:12.896Z","link":"/zh/ai-labs/high-quality-text-to-real-time-voice","sourceType":"aiLabs"}]}')},899054,e=>{"use strict";var t=e.i(843476),a=e.i(500932),n=e.i(149563);e.i(481210);var o=e.i(768622),i=e.i(632214);e.s(["FlyoutLink",0,e=>{let r,d,l,s,p,c,u=(0,a.c)(24),{linkProps:T,children:m,className:y}=e,{t:g}=(0,o.useTranslation)("index");u[0]!==T?(r=e=>{T.newTab||T.isExternal&&(e.preventDefault(),window.setTimeout(()=>{window.location.href=T.to},400)),T.trackLink?.(e)},u[0]=T,u[1]=r):r=u[1];let h=r,k=y??"\n    block\n    min-w-[176px]\n    r