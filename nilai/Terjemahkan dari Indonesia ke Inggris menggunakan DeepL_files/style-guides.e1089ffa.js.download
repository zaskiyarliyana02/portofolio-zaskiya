g_subsection_quotations_name":"Kutipan","item_form_section_spelling_subsection_special-characters_name":"Karakter khusus","item_form_section_spelling_subsection_spelled-out-numbers_name":"Angka yang ditulis secara lengkap","item_form_section_spelling_subsection_textual-quotations_name":"Kutipan teks","item_form_section_spelling_subsection_use-of-the-passive-voice_name":"Penggunaan kalimat pasif","item_form_section_spelling_subsection_verbs-ending-in-eler-eter_name":"Kata kerja yang berakhiran “-eler” dan “-eter”","item_form_section_spelling_subsection_voices_name":"Suara","item_form_section_style-tone_subsection_abbreviations_name":"Singkatan","item_form_section_style-tone_subsection_anglicisms_name":"Istilah-istilah Inggris","item_form_section_style-tone_subsection_country-names_name":"Nama negara","item_form_section_style-tone_subsection_double-negatives_name":"Negasi ganda","item_form_section_style-tone_subsection_formality-sentence-endings_name":"Formalitas dan akhir kalimat","item_form_section_style-tone_subsection_formality_name":"Tingkat formalitas","item_form_section_style-tone_subsection_inclusive-writing_name":"Penulisan inklusif","item_form_section_style-tone_subsection_language-style_name":"Gaya bahasa bahasa","item_form_section_style-tone_subsection_loanwords_name":"Kata serapan","item_form_section_style-tone_subsection_tone_name":"Bentuk Nada","item_form_field_ja_punctuation-v2_corner-brackets-and-periods_option_add-period-after-closing-corner-bracket-at-end-of-sentence_name":"Jika teks isi berhenti di tanda kurung siku, tambahkan titik setelah tanda kurung siku penutup","item_form_field_ja_punctuation-v2_corner-brackets-and-periods_option_add-period-after-closing-corner-bracket-at-end-of-sentence_example":"Contoh: Mengutip kata-kata seorang ahli, “Ini adalah situasi yang tidak terduga.”","item_form_field_ja_punctuation-v2_corner-brackets-and-periods_option_do-not-add-period-before-closing-corner-bracket-when-sentence-continues_name":"Jika teks isi ber