(function () {
  var globalScope = typeof self !== 'undefined' ? self : this;
  if (globalScope.__DEEPL_I18N__) {
    return;
  }
  var store = {
    bundles: {},
    listeners: [],
    push: function (lang, ns, data) {
      if (!store.bundles[lang]) {
        store.bundles[lang] = {};
      }
      store.bundles[lang][ns] = data;
      for (var i = 0; i < store.listeners.length; i++) {
        store.listeners[i](lang, ns, data);
      }
    }
  };
  globalScope.__DEEPL_I18N__ = store;
